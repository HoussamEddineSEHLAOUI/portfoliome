    "deploy:worker": "npm run build:worker && wrangler deploy"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "autoprefixer": "10.4.20",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.2",
    "framer-motion": "^13.1.1",
    "next": "^16.3.2",
    "postcss": "8.4.47",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-icons": "^5.5.0",
    "tailwindcss": "3.4.13",
    "wrangler": "^4.86.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@types/node": "22.7.4",
    "@types/react": "18.3.11",
    "daisyui": "^4.12.12",
    "typescript": "5.6.3"
  }
